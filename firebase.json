{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": true,
    "headers": [
      { "source": "service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
